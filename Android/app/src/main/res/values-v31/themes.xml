<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12 draws its own splash window. Point it at the same background
        and the safe square mark rather than letting it infer the launcher
        icon; the wide launch_mark vector is for the pre-12 window background.
    -->
    <style name="Theme.Fathom" parent="Theme.Fathom.Base">
        <item name="android:windowSplashScreenBackground">@color/fathom_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
