<?xml version="1.0" encoding="utf-8"?>
<!--
    The launch window before Android 12. From 12 the system splash attributes
    in values-v31 take over; both carry the same bar mark.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/fathom_background" />
    <item
        android:drawable="@drawable/launch_mark"
        android:gravity="center" />
</layer-list>
