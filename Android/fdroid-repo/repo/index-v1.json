{"repo": {"timestamp": 1794184287000, "version": 20002, "name": "Fathom", "icon": "fathom-icon.png", "address": "https://fathom-app-delta.vercel.app/fdroid/repo", "description": "A read-only teal.fm dashboard for Android."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorEmail": "contact@ewancroft.uk", "authorName": "Ewan Croft", "categories": ["Internet", "Multimedia"], "changelog": "https://github.com/ewanc26/fathom/releases", "suggestedVersionName": "0.2.1", "suggestedVersionCode": "10", "description": "Fathom is a native dashboard for the plays already in your AT Protocol\nrepository. It shows what is playing now, the last seven or thirty days,\nall-time totals, top artists, releases and tracks, and the full history\ngrouped by the local day.\n\nIt is read-only. Fathom has no account, password or token. It resolves your\nhandle, finds your Personal Data Server and reads the public teal.fm records\ndirectly. There is no Fathom backend in the middle. The figures are computed\non the device by a shared Kotlin core.\n\nA read that ends early is labelled partial rather than presented as complete.\nThe saved history is app-private, excluded from Android backup and device\ntransfer, and contains only public records.\n\nFathom is not affiliated with teal.fm or Bluesky.", "issueTracker": "https://github.com/ewanc26/fathom/issues", "license": "AGPL-3.0-only", "name": "Fathom", "sourceCode": "https://github.com/ewanc26/fathom", "summary": "Read-only teal.fm listening dashboard", "webSite": "https://fathom-app-delta.vercel.app/", "added": 1794183178000, "icon": "uk.ewancroft.fathom.10.png", "packageName": "uk.ewancroft.fathom", "lastUpdated": 1794183403000}], "packages": {"uk.ewancroft.fathom": [{"added": 1794183403000, "apkName": "Fathom-0.2.1.apk", "hash": "e224cd218153d55995f7240fa28402adcf7762db8d24ecbe2a26d109de3d02b3", "hashType": "sha256", "minSdkVersion": 26, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "packageName": "uk.ewancroft.fa